VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional local XAMPP TCPDF adapter, for example http://localhost/Payroll/Payroll2/php
VITE_PHP_PDF_URL=

# Used only by trusted migration and server-side scripts. Never expose this in VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=aura_payroll
MYSQL_USER=root
MYSQL_PASSWORD=
